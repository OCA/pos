<templates id="template" xml:space="preserve">
    <t
        t-name="pos_order_line_change_variant.ProductConfiguratorPopup"
        t-inherit="point_of_sale.ProductConfiguratorPopup"
        t-inherit-mode="extension"
    >
        <!-- Stock template never passes defaultValues to MultiProductAttribute. -->
        <xpath expr="//MultiProductAttribute" position="attributes">
            <attribute name="defaultValues">this.props.defaultValues</attribute>
        </xpath>
    </t>
</templates>
