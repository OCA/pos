<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="pos_config_logo.Navbar"
        t-inherit="point_of_sale.Navbar"
        t-inherit-mode="extension"
    >
        <xpath expr="//img[hasclass('pos-logo')]" position="replace">
            <img
                t-if="pos.config.logo"
                class="pos-logo mw-100"
                height="42"
                t-att-src="pos.getNavbarLogoUrl()"
                t-on-click="() => debug.toggleWidget()"
                alt="Logo"
            />
            <img
                t-else=""
                class="pos-logo mw-100"
                height="42"
                t-on-click="() => debug.toggleWidget()"
                src="/web/static/img/logo.png"
                alt="Logo"
            />
        </xpath>
    </t>
</templates>
