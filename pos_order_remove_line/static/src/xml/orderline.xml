<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('line-details')]" position="inside">
            <button
                class="btn remove-line-button ms-2"
                t-if="isDisplayButtonRemove"
                t-on-click="(event) => this.removeLine(event)"
            >
                <i class="fa fa-trash-o" />
            </button>
        </xpath>
    </t>
</templates>
