<templates id="template" xml:space="preserve">

    <t
        t-name="PosCashMoveReason"
        t-inherit="point_of_sale.CashMovePopup"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//textarea[@name='reason']" position="before">


            <t t-if="filteredMoveReasons.length > 0">
                <!-- MOVE REASONS -->
                <h4 class="cash-move-reason-title"><i class="fa fa-question-circle" />
                    Choose the reason
                </h4>
                <t
                    t-foreach="filteredMoveReasons"
                    t-as="move_reason"
                    t-key="move_reason.id"
                >
                    <div
                        class="button dynamic-size"
                        t-on-click="() => this.onClickMoveReason(move_reason.id)"
                        t-att-class="{ 'highlight': state.inputMoveReason == move_reason.id }"
                    >
                        <span t-esc="move_reason.name" />
                    </div>
                </t>
            </t>

            <!-- LINKED ACCOUNT JOURNAL -->
            <t t-if="filteredJournals.length > 0">
                <t t-if="filteredJournals.length > 1">
                    <h4 class="cash-move-reason-title"><i
                            class="fa fa-money"
                        /> Choose the journal</h4>
                </t>
                <t t-elif="filteredJournals.length == 1">
                    <h4 class="cash-move-reason-title"><i
                            class="fa fa-money"
                        /> Account journal</h4>
                </t>
                <t t-foreach="filteredJournals" t-as="journal" t-key="journal.id">
                    <div
                        class="button dynamic-size"
                        t-on-click="() => this.onClickMoveReasonJournal(journal.id)"
                        t-att-class="{ 'highlight': state.inputMoveReasonJournal == journal.id }"
                    >
                        <span t-esc="journal.name" />
                    </div>
                </t>
            </t>

        </xpath>
    </t>

</templates>
