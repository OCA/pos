<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentlines')]/span" position="after">
            <t t-if="line.foreign_currency_name">
                <div class="pos-receipt-foreign">
                    <span t-esc="line.foreign_amount_display" />
                    <div t-esc="line.foreign_rate_label" />
                </div>
            </t>
        </xpath>
    </t>
</templates>
