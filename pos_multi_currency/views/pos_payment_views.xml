<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_payment_view_form" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.pos.multi.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="foreign_currency_id" />
                <field name="amount_currency" />
                <field name="foreign_currency_rate" digits="[12,12]" />
            </xpath>
        </field>
    </record>

    <record id="pos_payment_view_tree" model="ir.ui.view">
        <field name="name">pos.payment.tree.inherit.pos.multi.currency</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="after">
                <field name="foreign_currency_id" optional="show" />
                <field name="amount_currency" optional="show" />
                <field name="foreign_currency_rate" digits="[12,12]" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
