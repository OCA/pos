<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_order_view_form" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.pos.multi.currency</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='payments']//field[@name='amount']"
                position="after"
            >
                <field name="foreign_currency_id" optional="show" />
                <field name="amount_currency" optional="show" />
                <field name="foreign_currency_rate" digits="[12,12]" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
