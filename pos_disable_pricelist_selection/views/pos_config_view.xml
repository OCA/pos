<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_config_view_form_inherit_pricelist_button" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.hide_pricelist_button</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting
                    string="Hide Pricelist Button"
                    help="If enabled, the pricelist selection button will be hidden in the PoS interface."
                >
                    <field name="hide_pricelist_button" />
                    <field name="company_id" invisible="1" />
                    <field name="available_pricelist_ids" invisible="1" />
                </setting>

                <setting
                    string="Selectable Pricelists"
                    help="Select the pricelists available for selection in the PoS interface. If empty, all available pricelists will be selectable. This setting is ignored if 'Hide Pricelist Button' is enabled."
                >
                    <field
                        name="selectable_pricelist_ids"
                        widget="many2many_tags"
                        invisible="hide_pricelist_button"
                    />
                    <div class="text-muted" invisible="hide_pricelist_button">
                        Make sure Default Pricelist is within selectable pricelists.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
