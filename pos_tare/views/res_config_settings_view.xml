<?xml version="1.0" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">pos.config.form.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='customer_display']" position="after">
                <div
                    class="col-xs-12 col-lg-6 o_setting_box"
                    id="pos_iface_tare_method"
                >
                    <div class="o_setting_right_pane">
                        <label for="pos_iface_tare_method" string="Tare Input Method" />
                        <div class="text-muted">
                            Configure how to tare products to weight with a scale.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="pos_iface_tare_method" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-lg-6 o_setting_box" id="pos_iface_tare_uom">
                    <div class="o_setting_right_pane">
                        <label for="pos_iface_tare_uom_id" string="Tare UoM" />
                        <div class="text-muted">
                            Unit of Measure of the tares.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="pos_iface_tare_uom_id" />
                            </div>
                        </div>
                    </div>
                </div>
                <div
                    class="col-xs-12 col-lg-6 o_setting_box"
                    id="pos_iface_gross_weight_method"
                >
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_iface_gross_weight_method"
                            string="Gross Weight Input Method"
                        />
                        <div class="text-muted">
                            Configure how to input Gross Weight.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field name="pos_iface_gross_weight_method" />
                            </div>
                        </div>
                    </div>
                </div>
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="pos_iface_send_tare_to_scale"
                >
                    <div class="o_setting_left_pane">
                        <field name="pos_iface_send_tare_to_scale" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_iface_send_tare_to_scale"
                            string="Send Tare To Scale"
                        />
                        <div class="text-muted">
                            Send the tare weight when reading the scale value, to allow the scale to display the tare and the net weights. Requires a compatible device proxy, like odoo-driver.
                        </div>
                    </div>
                </div>
                <div
                    class="col-xs-12 col-lg-6 o_setting_box"
                    id="pos_iface_tare_scale_precision"
                >
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_iface_tare_method"
                            string="Tare Scale Precision"
                        />
                        <div class="text-muted">
                            Precision of the tare values that the scale can handle (in the unit of measure of the tare). The tare value will be rounded accordingly to ensure that the net weight displayed by the scale is equal to the one computed in the PoS. Example: 0.002 would round to multiples (steps) of 0.002. A value of 0 disables the rounding.
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="pos_iface_tare_scale_precision"
                                    class="oe_inline"
                                />
                                <!--
                                    force_save is needed otherwise
                                    modifying the value from the above
                                    setting (#pos_iface_tare_uom)
                                    doesn't work.
                                -->
                                <field
                                    name="pos_iface_tare_uom_id"
                                    readonly="1"
                                    force_save="1"
                                    class="ml4"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
