<templates id="template" xml:space="preserve">

    <t
        t-name="PosRestaurantSplitOrderUsability"
        t-inherit="pos_restaurant.SplitBillScreen"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//ul[@class='orderlines']" position="after">
            <div class="already-paid-lines">
                <AlreadyPaidLines t-props="{'order': currentOrder}" />
            </div>
        </xpath>
    </t>

</templates>
