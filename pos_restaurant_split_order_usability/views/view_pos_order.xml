<odoo>

    <record id="view_pos_restaurant_split_order_form" model="ir.ui.view">
        <field name="name">pos.order.form.view.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='customer_count']" position="after">
                <field name="origin_order_uid" readonly="1" />
            </xpath>
        </field>
    </record>

</odoo>
