<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting
                    id="pos_minimize_menu"
                    help="Set technical names of buttons that will be displayed in the main point of sale screen. Other buttons will be available by clicking on the button 'More...'"
                >
                    <field
                        name="pos_iface_important_buttons"
                        placeholder="e.g. OrderlineCustomerNoteButton"
                    />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
