<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="pos_ship_later_default.PaymentScreenButtons"
        t-inherit="point_of_sale.PaymentScreenButtons"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//button[@t-on-click='toggleShippingDatePicker']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >pos.config.ship_later and !pos.config.hide_ship_later_button</attribute>
        </xpath>
    </t>
</templates>
