<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <setting
                    id="pos_default_partner"
                    string="Default customer to use if none is set"
                    help="Fill in this field in order to use a default partner if none is set."
                >
                    <field name="pos_default_partner_id" />
                </setting>
            </xpath>

            <!--
            <setting
                    id="pos_config_logo_setting"
                    string="Alternative point of sale logo"
                    help="If set, this logo will be used instead of the company's one"
                >
                    <field name="has_pos_config_logo" />
                    <div class="content-group mt16" invisible="not has_pos_config_logo">
                        <field name="pos_config_logo" widget="image" class="w-25" />
                    </div>
                </setting> -->
        </field>
    </record>
</odoo>
