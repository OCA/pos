<odoo>
    <record id="pos_config_view_form_pos_combo" model="ir.ui.view">
        <field name="name">pos.config.form.pos.combo</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[hasclass('row', 'mt16', 'o_settings_container')][last()]"
                position="inside"
            >
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="view_combo_product_image" />
                    </div>
                    <div class="o_setting_right_pane">
                        <span
                            class="fa fa-lg fa-cubes text-primary me-1"
                            title="Combo Product Image"
                        />
                        <label for="view_combo_product_image" />
                        <div class="text-muted">
                            Display product thumbnails inside the POS combo configuration popup.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
