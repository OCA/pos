<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="CreateOrderPopup"
        t-inherit="pos_order_to_sale_order.CreateOrderPopup"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath
            expr="//tr[@t-if='env.pos.config.iface_create_draft_sale_order']"
            position="before"
        >
            <tr t-if="env.pos.config.iface_sale_order_allow_commitment_date">
                <td>
                    <div
                        class="button pos_commitment_button"
                        t-att-class="{ highlight: state.addCommitmentDate }"
                        t-on-click="() => this.onClickToAddCommitmentDate()"
                    >
                        <i class="fa fa-calendar" /> Add a Commitment Date
                    </div>
                </td>
            </tr>
        </xpath>
    </t>
</templates>
