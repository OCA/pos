<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.pos_sale_picking_keep</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95" />
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="inside">
                <setting
                    title="Keep pickings in sales strategy."
                    string="Keep Picking Strategy"
                    help="Choose a keep picking strategy."
                >
                    <field name="pos_keep_picking" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
