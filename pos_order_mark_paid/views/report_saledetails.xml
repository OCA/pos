<odoo>
    <template id="report_saledetails" inherit_id="point_of_sale.report_saledetails">
        <xpath expr="//t[@t-if='cash_rounding_total']" position="after">
            <t t-if="write_off_total">
                <strong>Write-off:
                    <span t-if="currency['position']">
                        <span
                            t-out="write_off_total"
                            t-options="{'widget': 'float', 'precision': currency['precision']}"
                        >0.00</span>
                        <span t-out="currency['symbol']">$</span>
                    </span>
                    <span t-else="">
                        <span t-out="currency['symbol']">$</span>
                        <span
                            t-out="write_off_total"
                            t-options="{'widget': 'float', 'precision': currency['precision']}"
                        >0.00</span>
                    </span>
                </strong>
                <br />
            </t>
        </xpath>
    </template>
</odoo>
