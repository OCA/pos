<templates id="template" xml:space="preserve">

    <t
        t-name="PaymentScreenShowOrder"
        t-inherit="point_of_sale.PaymentScreen"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[@class='payment-buttons']" position="after">
            <div class="payment-show-order">
                <p class="title-category">Order Details</p>
                <OrderDetails t-props="{'order': currentOrder}" />
            </div>
        </xpath>
    </t>

</templates>
