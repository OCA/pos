<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rule_pos_config_user_allowed" model="ir.rule">
        <field name="name">POS Config: User Allowed POS</field>
        <field name="model_id" ref="point_of_sale.model_pos_config" />
        <field
            name="domain_force"
        >[('id', 'in', user.allowed_pos_config_ids.ids)] if user.allowed_pos_config_ids else [(1, '=', 1)]</field>
    </record>

