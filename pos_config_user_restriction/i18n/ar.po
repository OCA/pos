#. module: pos_config_user_restriction
msgid "Point of Sale Access"
msgstr "تخصيص نقاط البيع"

#. module: pos_config_user_restriction
msgid "Allowed Points of Sale"
msgstr "نقاط البيع المسموحة"

#. module: pos_config_user_restriction
msgid "Leave empty to allow all POS"
msgstr "اتركه فارغاً للسماح بجميع نقاط البيع"

#. module: pos_config_user_restriction
msgid "Hide POS Configuration Menus"
msgstr "إخفاء قوائم تهيئة نقاط البيع"

#. module: pos_config_user_restriction
msgid "When set, restricts user access to the selected POS configurations. Leave empty to allow all."
msgstr "عند تحديد نقطة بيع أو أكثر، يقتصر وصول المستخدم على نقاط البيع المحددة فقط. اتركه فارغاً للسماح بالجميع."

#. module: pos_config_user_restriction
msgid "Hide Point of Sale configuration menus for this user while keeping cashier and session operations."
msgstr "يخفي قوائم تهيئة نقاط البيع للمستخدم مع الإبقاء على عمليات الكاشير وإغلاق الجلسات."
