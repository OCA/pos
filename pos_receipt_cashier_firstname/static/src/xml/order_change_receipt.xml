<templates id="template" xml:space="preserve">
    <t
        t-name="pos_receipt_cashier_firstname.OrderChangeReceipt"
        t-inherit="point_of_sale.OrderChangeReceipt"
        t-inherit-mode="extension"
    >
        <xpath expr="//t[@t-esc='changes.employee_name']/.." position="attributes">
            <attribute name="t-if">changes.employee_name</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o-employee-name')]/br" position="attributes">
            <attribute name="t-if">changes.employee_name</attribute>
        </xpath>
    </t>
