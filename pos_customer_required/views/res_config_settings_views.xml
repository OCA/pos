<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.pos_customer_required</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="product_prices" position="after">
                <div class="col-xs-12 col-lg-6 o_setting_box" id="pos_require_customer">
                    <div class="o_setting_right_pane">
                        <label for="pos_require_customer" string="Require Customer" />
                        <div class="text-muted">
                            Require Customer
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                                    name="pos_require_customer"
                                    class="o_light_label"
                                    widget="radio"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
