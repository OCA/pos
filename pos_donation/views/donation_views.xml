<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="donation_form" model="ir.ui.view">
        <field name="name">donation.form.pos.order</field>
        <field name="model">donation.donation</field>
        <field name="inherit_id" ref="donation.donation_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_pos_order_id"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    attrs="{'invisible':[('pos_order_id', '=', False)]}"
                >
                    <field name="pos_order_id" string="POS Order" widget="statinfo" />
                </button>
            </div>
            <field name="payment_mode_id" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|', ('pos_payment_ids', '=', True), ('state', '=', 'done')]}
                </attribute>
            </field>
            <field name="payment_mode_id" position="after">
                <field
                    name="pos_payment_ids"
                    widget="many2many_tags"
                    readonly="true"
                    invisible="true"
                />
                <field
                    name="displayed_payment_mode"
                    attrs="{'invisible': [('pos_payment_ids', '=', []), ('state', '!=', 'done')]}"
                />
            </field>
        </field>
    </record>

    <record id="donation_tree" model="ir.ui.view">
        <field name="name">donation.tree.pos.order</field>
        <field name="model">donation.donation</field>
        <field name="inherit_id" ref="donation.donation_tree" />
        <field name="arch" type="xml">
            <field name="payment_ref" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
            <field name="payment_mode_id" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
            <field name="payment_mode_id" position="after">
                <field name="displayed_payment_mode" />
            </field>
        </field>
    </record>

</odoo>
