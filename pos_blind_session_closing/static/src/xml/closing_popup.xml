    <t
        t-name="pos_blind_session_closing.ClosePosPopup"
        t-inherit="point_of_sale.ClosePosPopup"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('total-orders')]" position="attributes">
            <attribute name="t-if">this.canSeeClosingAmounts</attribute>
        </xpath>

        <!-- Hide the whole expected-amounts overview (cash, cards, customer
             account, and any other payment method), including pos_hr's
             replacement block. Per-row xpaths only match the first node and
             translated labels like "Difference"/"Diferencia". -->
        <xpath expr="//div[hasclass('payment-methods-overview')]" position="attributes">
            <attribute
                name="t-if"
            >this.canSeeClosingAmounts and !pos.config.module_pos_hr</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('payment-methods-overview')]/following-sibling::t[@t-if='pos.config.module_pos_hr']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >this.canSeeClosingAmounts and pos.config.module_pos_hr</attribute>
        </xpath>
        <xpath
            expr="//div[hasclass('payment-methods-overview')]/following-sibling::hr"
            position="attributes"
        >
            <attribute name="t-if">this.canSeeClosingAmounts</attribute>
        </xpath>

        <xpath expr="//button[@t-on-click='autoFillCashCount']" position="attributes">
            <attribute name="t-if">this.canSeeClosingAmounts</attribute>
        </xpath>
        <xpath
            expr="//button[contains(@t-on-click, 'autoFillPMCount')]"
            position="attributes"
        >
            <attribute name="t-if">this.canSeeClosingAmounts</attribute>
        </xpath>

        <xpath expr="//button[contains(@title, 'Download')]" position="attributes">
            <attribute name="t-if">this.canSeeClosingAmounts</attribute>
        </xpath>
    </t>
</templates>
