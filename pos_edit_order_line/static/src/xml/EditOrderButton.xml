<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t
        t-name="pos_edit_order_line.EditOrderButton"
        t-inherit="point_of_sale.ControlButtons"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//t[@t-if='this.props.showRemainingButtons']/div"
            position="inside"
        >
            <t
                t-if="this.pos.config.allow_edit_order_line"
                t-call="point_of_sale.controlButton"
                icon="'edit'"
                btnText.translate="Edit Order Lines"
                btnClasses="'btn-secondary '"
                onClick="() => this.onClickEditOrder()"
            />
        </xpath>
    </t>

</templates>
