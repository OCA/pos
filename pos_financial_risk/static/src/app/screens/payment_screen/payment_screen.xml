<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath
            expr="//t[@t-foreach='payment_methods_from_config']"
            position="attributes"
        >
            <attribute name="t-foreach">paymentMethodsUnlock</attribute>
        </xpath>
        <xpath expr="//div[hasclass('paymentmethods')]" position="inside">
            <div t-if="pos.riskLimit > 0" class="btn btn-warning my-2">
                <span>
                    Remainder <t t-out="remainderLimitFormatted" />
                </span>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('paymentmethods')]" position="after">
            <div
                class="paymentmethods gap-1 gap-lg-2"
                t-att-class="{ 'd-grid p-1 gap-1 overflow-y-auto rounded-3 bg-200': ui.isSmall, 'd-flex flex-column gap-lg-2': !ui.isSmall }"
                t-if="paymentMethodsLock.length > 0"
            >
                <div class="btn payment-lock-title">
                    <span>Blocked due to credit limit reached</span>
                </div>
                <t
                    t-foreach="paymentMethodsLock"
                    t-as="paymentMethod"
                    t-key="paymentMethod.id"
                >
                    <div
                        t-if="!(this.pos.cashier._role === 'minimal' and paymentMethod.type === 'pay_later')"
                        class="button paymentmethod btn btn-secondary btn-lg lh-lg flex-fill payment-red"
                        t-att-class="{'opacity-50': this.pos.paymentTerminalInProgress and paymentMethod.use_payment_terminal, 'd-flex justify-content-between align-items-center': true}"
                    >
                        <div
                            class="payment-method-display d-flex align-items-center gap-2 text-wrap text-start lh-sm"
                        >
                            <img
                                class="payment-method-icon"
                                t-att-src="paymentMethodImage(paymentMethod.id)"
                            />
                            <span class="payment-name" t-esc="paymentMethod.name" />
                        </div>
                        <span
                            class="text-muted"
                            t-esc="pos.getPaymentMethodFmtAmount(paymentMethod, currentOrder)"
                        />
                    </div>
                </t>
            </div>
        </xpath>
    </t>
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath
            expr="//div[hasclass('payment-buttons')]//button[hasclass('partner-button')]"
            position="attributes"
        >
            <attribute name="t-att-class">{
                highlight: currentOrder.getPartner(),
                error_risk: currentOrder.getPartner() &amp;&amp; pos.riskLimit > 0 &amp;&amp; pos.remainderLimit &lt;= 0 }
            </attribute>
        </xpath>
    </t>
</templates>
