<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.pos_barcode_rule_priced_with_change_rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="barcode_scanner" position="inside">
                <div class="content-group mt16 row">
                    <label
                        for="change_rate_barcode"
                        string="Change Rate"
                        class="col-lg-3 o_light_label"
                    />
                    <field name="change_rate_barcode" />
                </div>
            </setting>
        </field>
    </record>
</odoo>
