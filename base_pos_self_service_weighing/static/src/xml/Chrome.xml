<templates id="template" xml:space="preserve">

    <t
        t-name="Chrome"
        t-inherit="point_of_sale.Chrome"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('pos-topheader')]" position="attributes">
            <attribute name="t-if">!isSelfService()</attribute>
        </xpath>

        <xpath expr="//div[hasclass('pos-content')]" position="attributes">
            <attribute name="t-att-class">{"self-service": isSelfService()}</attribute>
        </xpath>
    </t>

</templates>
