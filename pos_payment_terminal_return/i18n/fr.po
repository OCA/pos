#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid "Failed to payment terminal with return message: %s"
msgstr "Échec du terminal de paiement avec le message de retour : %s"

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"Failed to send the amount to pay to the payment terminal.Press the red "
"button on the payment terminal and try again."
msgstr ""
"Échec de l’envoi du montant à payer au terminal de paiement. "
"Appuyez sur le bouton rouge du terminal de paiement et réessayez."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid "Unknown error"
msgstr "Erreur inconnue"

#. module: pos_payment_terminal_return
#: model:ir.model.fields,field_description:pos_payment_terminal_return.field_pos_config_iface_payment_terminal_return
msgid "Wait Payment Terminal Return"
msgstr "Attendre le retour du terminal de paiement"

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"The POS cannot open the payment terminal port. Check that the terminal is plugged in, and its port in the PyWebDriver configuration."
msgstr ""
"La caisse ne peut pas ouvrir le port du terminal de paiement. Vérifiez que le terminal est branché, et son port dans la configuration de PyWebDriver."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"The payment terminal did not answer. Check that it is switched on, connected and on its idle screen, then try again."
msgstr ""
"Le terminal de paiement ne répond pas. Vérifiez qu'il est allumé, connecté et sur son écran d'accueil, puis réessayez."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"This payment mode or currency is not supported by the payment terminal."
msgstr ""
"Ce mode de paiement ou cette devise n'est pas pris en charge par le terminal de paiement."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"The payment terminal did not accept the amount: it may be busy with a previous transaction. Press the red button on the terminal, then try again."
msgstr ""
"Le terminal de paiement n'a pas accepté le montant : il est peut-être occupé par une transaction précédente. Appuyez sur le bouton rouge du terminal, puis réessayez."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"No answer from the payment terminal. Check that it is switched on and connected, then try again."
msgstr ""
"Pas de réponse du terminal de paiement. Vérifiez qu'il est allumé et connecté, puis réessayez."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
#, python-format
msgid ""
"No answer from the payment terminal within %s seconds after it took the amount, so the payment may have been approved."
msgstr ""
"Pas de réponse du terminal de paiement dans les %s secondes après qu'il a reçu le montant : le paiement a peut-être été accepté."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"The payment terminal took the amount, but its answer did not reach the POS, so the payment may have been approved."
msgstr ""
"Le terminal de paiement a reçu le montant, mais sa réponse n'est pas parvenue à la caisse : le paiement a peut-être été accepté."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid "Payment result unknown"
msgstr "Résultat du paiement inconnu"

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid ""
"Check the merchant receipt printed by the terminal:\n"
"- Approved: click \"Approved\" to record the payment.\n"
"- Refused, or no receipt: click \"Not approved\", then retry."
msgstr ""
"Vérifiez le ticket commerçant imprimé par le terminal :\n"
"- Accepté : cliquez sur « Accepté » pour enregistrer le paiement.\n"
"- Refusé, ou pas de ticket : cliquez sur « Non accepté », puis réessayez."

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid "Approved"
msgstr "Accepté"

#. module: pos_payment_terminal_return
#. odoo-javascript
#: code:addons/pos_payment_terminal_return/static/src/app/payment_terminal.esm.js:0
msgid "Not approved"
msgstr "Non accepté"
