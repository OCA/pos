<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="MembershipInfo" owl="1">
        <t t-set="_partner" t-value="props.line.partner_for_membership" />
        <li
            class="info membership-info"
            t-if="props.line.product.membership and _partner"
        >
            <i
                class="fa fa-hand-o-right"
                role="img"
                aria-label="Member"
                title="Member"
            />
            <t t-out="_partner.name" />
            <span t-if="!props.line.delegated_member"> (<i
                    class="fa fa-user"
                    role="img"
                    aria-label="Customer"
                    title="Customer"
                />)</span>
        </li>
    </t>

</templates>
