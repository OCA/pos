<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ProductConfiguratorPopup" t-inherit-mode="extension">
        <xpath expr="//ProductInfoBanner" position="before">
            <img
                t-if="imageUrl"
                t-att-src="imageUrl"
                class="pos-show-product-image"
                alt="Product image"
            />
        </xpath>
    </t>
</templates>
