<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='pos_is_self_service_weighing_station']/../.."
                position="after"
            >
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    attrs="{'invisible' : [('pos_is_self_service_weighing_station', '=', False)]}"
                >
                    <div class="o_setting_right_pane">
                        <span
                            class="o_form_label"
                        >Barcode Label Printer Configuration</span>
                        <div class="content-group mt16">
                            <div class="row">
                                <label
                                    for="pos_barcode_label_printer_name"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="pos_barcode_label_printer_name" />
                            </div>
                            <div class="row">
                                <label
                                    for="pos_barcode_label_width"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="pos_barcode_label_width" />
                            </div>
                            <div class="row">
                                <label
                                    for="pos_barcode_label_height"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="pos_barcode_label_height" />
                            </div>
                            <div class="row">
                                <label
                                    for="pos_barcode_label_offset_x"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="pos_barcode_label_offset_x" />
                            </div>
                            <div class="row">
                                <label
                                    for="pos_barcode_label_offset_y"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="pos_barcode_label_offset_y" />
                            </div>
                            <div class="row">
                                <label
                                    for="pos_barcode_label_darkness"
                                    class="col-lg-3 o_light_label"
                                />
                                <field name="pos_barcode_label_darkness" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
