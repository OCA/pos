<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t
        t-name="pos_customer_display_monitor.Navbar"
        t-inherit="point_of_sale.Navbar"
        t-inherit-mode="extension"
    >
        <xpath expr="//li[contains(@class, 'backend-button')]" position="before">
            <li
                t-if="showCustomerDisplayScreenSelector"
                class="menu-item navbar-button"
                t-on-click="selectCustomerDisplayScreen"
            >
                <a class="dropdown-item py-2">
                    Select customer display screen
                </a>
            </li>
        </xpath>
    </t>
</templates>
