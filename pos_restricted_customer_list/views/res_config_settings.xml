<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95" />
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[field[@name='pos_limit_categories']]"
                position="after"
            >
                <setting
                    string="Partner Category"
                    help="Filter partner from selected category"
                >
                    <field name="pos_partner_category" />
                    <div
                        class="content-group mt16"
                        invisible="not pos_partner_category"
                    >
                        <field name="pos_partner_category_id" />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
