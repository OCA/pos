<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.fee</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form" />
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field
                    name="use_transaction_fees"
                    attrs="{'invisible': [('type', '!=', 'bank')]}"
                />
            </field>
            <xpath expr="//sheet" position="inside">
                <notebook
                    name="pos_payment_method_fee_notebook"
                    attrs="{'invisible': ['|', ('type', '!=', 'bank'), ('use_transaction_fees', '=', False)]}"
                >
                    <page string="Transaction Fees" name="pos_payment_method_fees">
                        <group>
                            <field name="fee_grouping_policy" />
                        </group>
                        <field name="fee_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="company_id" invisible="1" />
                                <field name="name" />
                                <field name="fee_type" />
                                <field name="amount" />
                                <field
                                    name="currency_id"
                                    groups="base.group_multi_currency"
                                    attrs="{'invisible': [('fee_type', '!=', 'fixed')]}"
                                />
                                <field name="apply_on_refunds" />
                                <field name="posting_policy" />
                                <field name="account_id" />
                                <field
                                    name="counterpart_account_id"
                                    placeholder="Outstanding account of the method"
                                />
                                <field name="journal_id" />
                                <field name="active" optional="hide" />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
