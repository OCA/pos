<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_pos_payment_fee_line_tree" model="ir.ui.view">
        <field name="name">pos.payment.fee.line.tree</field>
        <field name="model">pos.payment.fee.line</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" edit="0">
                <field name="payment_id" />
                <field name="fee_rule_id" />
                <field name="amount_base" />
                <field name="fee_amount" />
                <field name="session_id" />
                <field
                    name="state"
                    decoration-success="state == 'posted'"
                    decoration-warning="state == 'draft'"
                    widget="badge"
                />
                <field name="account_move_line_id" />
                <field name="company_id" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="view_pos_payment_fee_line_search" model="ir.ui.view">
        <field name="name">pos.payment.fee.line.search</field>
        <field name="model">pos.payment.fee.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="payment_id" />
                <field name="fee_rule_id" />
                <field name="session_id" />
                <filter
                    string="Draft"
                    name="filter_draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Posted"
                    name="filter_posted"
                    domain="[('state', '=', 'posted')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Fee Rule"
                        name="group_fee_rule"
                        context="{'group_by': 'fee_rule_id'}"
                    />
                    <filter
                        string="Session"
                        name="group_session"
                        context="{'group_by': 'session_id'}"
                    />
                    <filter
                        string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_payment_fee_line" model="ir.actions.act_window">
        <field name="name">Payment Fee Lines</field>
        <field name="res_model">pos.payment.fee.line</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_pos_payment_fee_line_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No fee lines registered yet.
            </p>
            <p>
                This list displays full traceability of financial costs (fees)
                calculated per POS payment transaction.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_pos_payment_fee_line"
        name="Payment Fee Lines"
        parent="point_of_sale.menu_point_root"
        action="action_pos_payment_fee_line"
        sequence="80"
    />

</odoo>
