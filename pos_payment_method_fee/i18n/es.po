#. module: pos_payment_method_fee
#: model:ir.model.constraint,message:pos_payment_method_fee.constraint_pos_payment_fee_line_payment_rule_uniq
msgid "A fee rule can only be applied once per payment."
msgstr "Una regla de comisión solo puede aplicarse una vez por pago."

#. module: pos_payment_method_fee
#: model:ir.model.fields,help:pos_payment_method_fee.field_pos_payment_method_fee__counterpart_account_id
msgid ""
"Account credited as counterpart of the fee. Leave empty to use the "
"outstanding account of the payment method that is in force when the fee is "
"computed, so that the fee nets against the payment settled by the bank."
msgstr ""
"Cuenta acreditada como contraparte de la comisión. Déjelo vacío para usar la "
"cuenta pendiente del método de pago que esté en vigor cuando se calcule la "
"comisión, de modo que la comisión se compense con el pago liquidado por el "
"banco."

