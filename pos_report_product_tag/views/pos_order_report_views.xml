<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_report_pos_order_search_product_tag" model="ir.ui.view">
        <field name="name">report.pos.order.search.product.tag</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_search" />
        <field name="arch" type="xml">
            <field name="product_categ_id" position="after">
                <field name="product_tag_id" />
            </field>
            <filter name="product_category" position="after">
                <filter
                    string="Product Tag"
                    name="product_tag"
                    context="{'group_by':'product_tag_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
